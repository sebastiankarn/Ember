# Firebase configuration template for Godot Firebase plugin
# Copy this file to .env in the same directory and fill in real values.
# NEVER commit the real .env file.

# Core Web App Config (from Firebase Console > Project Settings > General > Your apps > Web app)
API_KEY=REPLACE_ME
APP_ID=REPLACE_ME
PROJECT_ID=REPLACE_ME
MESSAGING_SENDER_ID=REPLACE_ME
STORAGE_BUCKET=REPLACE_ME
AUTH_DOMAIN=REPLACE_ME
MEASUREMENT_ID=OPTIONAL_OR_REMOVE

# Feature flags / plugin toggles (adjust based on plugin docs)
ENABLE_ANALYTICS=false
ENABLE_PERFORMANCE=false
ENABLE_CRASHLYTICS=false
ENABLE_REMOTE_CONFIG=false

# Auth settings
# Set to true if you enabled Anonymous authentication in Firebase console.
ANON_AUTH_ENABLED=true

# If you later add OAuth providers you might add keys like:
# OAUTH_GOOGLE_CLIENT_ID=REPLACE_ME

# Notes:
# 1. After creating the real .env, restart the Godot editor or re-run the game so the plugin reloads it.
# 2. If you add new keys later, also update this example file so collaborators stay in sync.
# 3. Keep Firestore security rules aligned with your auth method. For dev you may allow authenticated users broadly; tighten for production.
